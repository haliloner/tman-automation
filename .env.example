# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env repoya GİRMEZ.
#   Mac:     cp .env.example .env
#   Windows: copy .env.example .env

# Giriş sayfasının adresi
LOGIN_URL=https://CHANGE-ME-login-host/auth-web/login.jsp

# Uygulamanın adresi (test ortamı)
BASE_URL=https://CHANGE-ME-app-host/

# Test kullanıcısı (ekipçe paylaşılan test hesabı önerilir)
TEST_USER=
TEST_PASSWORD=

# Remote (Windows) makinede: msedge  |  Mac'te demo için boş bırak (Chromium)
BROWSER_CHANNEL=
